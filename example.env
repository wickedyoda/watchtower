# Watchtower environment template
# Copy this file to .env and update values as needed.

# ------------------------------------------------------------
# Docker client settings
# ------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TLS_VERIFY=false
DOCKER_API_VERSION=

# ------------------------------------------------------------
# Core runtime settings
# ------------------------------------------------------------
TZ=UTC
NO_COLOR=false
WATCHTOWER_POLL_INTERVAL=86400
WATCHTOWER_SCHEDULE=
WATCHTOWER_CRON_SCHEDULE=0 0 4 * * *
WATCHTOWER_TIMEOUT=10s
WATCHTOWER_NO_PULL=false
WATCHTOWER_NO_RESTART=false
WATCHTOWER_NO_STARTUP_MESSAGE=false
WATCHTOWER_CLEANUP=false
WATCHTOWER_REMOVE_VOLUMES=false
WATCHTOWER_LABEL_ENABLE=false
WATCHTOWER_DISABLE_CONTAINERS=
WATCHTOWER_LOG_FORMAT=auto
WATCHTOWER_LOG_LEVEL=info
WATCHTOWER_DEBUG=false
WATCHTOWER_TRACE=false
WATCHTOWER_MONITOR_ONLY=false
WATCHTOWER_RUN_ONCE=false
WATCHTOWER_INCLUDE_RESTARTING=false
WATCHTOWER_INCLUDE_STOPPED=false
WATCHTOWER_REVIVE_STOPPED=false
WATCHTOWER_LIFECYCLE_HOOKS=false
WATCHTOWER_ROLLING_RESTART=false
WATCHTOWER_SCOPE=
WATCHTOWER_LABEL_TAKE_PRECEDENCE=false
WATCHTOWER_PORCELAIN=
WATCHTOWER_WARN_ON_HEAD_FAILURE=auto

# ------------------------------------------------------------
# Demo compose defaults
# ------------------------------------------------------------
GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# ------------------------------------------------------------
# Container networking demo
# ------------------------------------------------------------
VPN_SERVICE_PROVIDER=
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=

# ------------------------------------------------------------
# HTTP API settings
# ------------------------------------------------------------
WATCHTOWER_HTTP_API_UPDATE=false
WATCHTOWER_HTTP_API_METRICS=false
WATCHTOWER_HTTP_API_TOKEN=demotoken
WATCHTOWER_HTTP_API_PERIODIC_POLLS=false

# ------------------------------------------------------------
# Uptime Kuma integration settings
# ------------------------------------------------------------
WATCHTOWER_UPTIME_KUMA_URL=
WATCHTOWER_UPTIME_KUMA_API_KEY=

# ------------------------------------------------------------
# Notification settings
# ------------------------------------------------------------
# Comma-separated list, example: shoutrrr,email,slack,msteams,gotify
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATIONS_LEVEL=info
WATCHTOWER_NOTIFICATIONS_DELAY=0
WATCHTOWER_NOTIFICATIONS_HOSTNAME=

# Email notifier
WATCHTOWER_NOTIFICATION_EMAIL_FROM=
WATCHTOWER_NOTIFICATION_EMAIL_TO=
WATCHTOWER_NOTIFICATION_EMAIL_DELAY=0
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=25
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_TLS_SKIP_VERIFY=false
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=
WATCHTOWER_NOTIFICATION_EMAIL_SUBJECTTAG=

# Slack notifier
WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=
WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER=watchtower
WATCHTOWER_NOTIFICATION_SLACK_CHANNEL=
WATCHTOWER_NOTIFICATION_SLACK_ICON_EMOJI=
WATCHTOWER_NOTIFICATION_SLACK_ICON_URL=

# Microsoft Teams notifier
WATCHTOWER_NOTIFICATION_MSTEAMS_HOOK_URL=
WATCHTOWER_NOTIFICATION_MSTEAMS_USE_LOG_DATA=false

# Discord notifier (direct legacy-style settings)
WATCHTOWER_NOTIFICATION_DISCORD_HOOK_URL=
WATCHTOWER_NOTIFICATION_DISCORD_IDENTIFIER=watchtower
WATCHTOWER_NOTIFICATION_DISCORD_AVATAR_URL=

# Gotify notifier
WATCHTOWER_NOTIFICATION_GOTIFY_URL=
WATCHTOWER_NOTIFICATION_GOTIFY_TOKEN=
WATCHTOWER_NOTIFICATION_GOTIFY_TLS_SKIP_VERIFY=false

# Shoutrrr notifier
# Comma-separated URLs, example: discord://token@id
WATCHTOWER_NOTIFICATION_URL=
# Alias for webhook-style URLs (also shoutrrr-compatible)
WATCHTOWER_NOTIFICATION_WEBHOOK_URL=
WATCHTOWER_NOTIFICATION_TEMPLATE=
WATCHTOWER_NOTIFICATION_REPORT=false
WATCHTOWER_NOTIFICATION_TITLE_TAG=
WATCHTOWER_NOTIFICATION_SKIP_TITLE=false
WATCHTOWER_NOTIFICATION_LOG_STDOUT=false
